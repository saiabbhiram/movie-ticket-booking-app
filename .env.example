# ==========================================
# CineBook Environment Configuration
# ==========================================

# MySQL Database Configuration (Docker Compose Local)
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=movie_booking_db
MYSQL_USER=cinebook_user
MYSQL_PASSWORD=cinebook_pass123

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Backend Database Connection
# Use 'mysql' when running via Docker Compose, 'localhost' for local MySQL,
# or your AWS RDS endpoint for cloud deployment.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cinebook_user
DB_PASSWORD=cinebook_pass123
DB_NAME=movie_booking_db
DB_SSL=false

# JWT Authentication Secret (Change in production!)
JWT_SECRET=cinebook_super_secret_jwt_key_change_in_prod
JWT_EXPIRES_IN=24h

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
